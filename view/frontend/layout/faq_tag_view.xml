<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magendoo\Faq\Block\Faq\Tag\View" name="faq.tag.view" template="Magendoo_Faq::tag/view.phtml"/>
        </referenceContainer>
        <referenceContainer name="head.additional">
            <block class="Magendoo\Faq\Block\Faq\Canonical" name="faq.tag.canonical"
                   ifconfig="magendoo_faq/seo/use_canonical"/>
        </referenceContainer>
    </body>
</page>
