<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="breadcrumbs">
            <!-- breadcrumbs handled by controller -->
        </referenceBlock>
        <referenceContainer name="content">
            <!--
              No cache_lifetime here: the page is already full-page cached, and a
              block_html entry would be keyed without the customer group
              (Template::getCacheKeyInfo()) while the block renders group-filtered
              content — one group's categories would leak into every other group's
              first page render.
            -->
            <block class="Magendoo\Faq\Block\Faq\Home" name="faq.home" template="Magendoo_Faq::home.phtml"/>
        </referenceContainer>
        <referenceContainer name="head.additional">
            <block class="Magendoo\Faq\Block\Faq\Hreflang" name="faq.home.hreflang"
                   template="Magendoo_Faq::hreflang.phtml"
                   ifconfig="magendoo_faq/seo/hreflang_enabled"/>
        </referenceContainer>
    </body>
</page>
