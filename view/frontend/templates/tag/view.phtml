/** @var \Magendoo\Faq\Block\Faq\Tag\View $block */
?>
<?php $tag = $block->getTag(); ?>
<?php if ($tag): ?>
<div class="faq-tag-view">
    <div class="faq-questions-list">
        <?php $questions = $block->getQuestions(); ?>
        <?php if ($questions && $questions->getSize()): ?>
            <?php foreach ($questions as $question): ?>
            <div class="faq-question-item">
                <h3 class="faq-question-title">
                    <a href="<?= $escaper->escapeUrl($block->getQuestionUrl($question)) ?>">
                        <?= $escaper->escapeHtml($question->getTitle()) ?>
                    </a>
                </h3>
            </div>
            <?php endforeach; ?>
        <?php else: ?>
            <p><?= $escaper->escapeHtml(__('No questions with this tag.')) ?></p>
        <?php endif; ?>
    </div>
</div>
<?php endif; ?>
