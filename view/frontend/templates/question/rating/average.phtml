/** @var \Magendoo\Faq\Block\Faq\Question\Rating $block */
?>
<?php $question = $block->getQuestion(); ?>
<?php if ($question): ?>
<?php // Clamp: rows written before the star scale existed may hold a percent value. ?>
<?php $avg = min(5.0, max(0.0, $block->getAverageRating())); ?>
<div class="faq-rating faq-rating--average"
     data-question-id="<?= (int) $question->getQuestionId() ?>"
     data-mage-init='{"faqRating": {}}'>
    <div class="rating-stars" data-rating="<?= $escaper->escapeHtmlAttr(number_format($avg, 2, '.', '')) ?>">
        <?php for ($i = 1; $i <= 5; $i++): ?>
            <span class="star <?= $i <= (int) round($avg) ? 'filled' : 'empty' ?>" aria-hidden="true">&#9733;</span>
        <?php endfor; ?>
    </div>
    <span class="rating-value">
        <?= $escaper->escapeHtml(number_format($avg, 1)) ?> <?= $escaper->escapeHtml(__('/ 5')) ?>
    </span>
    <div class="rating-input" role="radiogroup" aria-label="<?= $escaper->escapeHtmlAttr(__('Rate this answer')) ?>">
        <span class="rating-label"><?= $escaper->escapeHtml(__('Rate this answer:')) ?></span>
        <?php for ($i = 1; $i <= 5; $i++): ?>
            <button type="button" class="action faq-star" data-vote="<?= (int) $i ?>"
                    data-url="<?= $escaper->escapeUrl($block->getRateUrl()) ?>"
                    title="<?= $escaper->escapeHtmlAttr(__('Rate %1 out of 5', $i)) ?>"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Rate %1 out of 5', $i)) ?>">&#9734;</button>
        <?php endfor; ?>
    </div>
</div>
<?php endif; ?>
